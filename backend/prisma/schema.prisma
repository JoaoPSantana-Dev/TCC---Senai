generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  idUsuario Int     @id @default(autoincrement()) @map("id_usuario")
  nome      String
  email     String
  senha     String
  funcao    String
  unidade   String

  @@map("usuarios")
}

model Pagina {
  idPaginas  Int     @id @default(autoincrement()) @map("id_paginas")
  nomePagina String
  tipoPagina String
  textos     Texto[]

  @@map("paginas")
}

model Texto {
  idTextos  Int     @id @default(autoincrement()) @map("id_texto")
  texto     String
  tipoTexto String
  idPagina  Int     @map("id_paginas")
  pagina    Pagina @relation(fields: [idPagina], references: [idPaginas])

  @@map("textos")
}

model VagaEmprego {
  idEmprego   Int     @id @default(autoincrement()) @map("id_emprego")
  nomeEmpresa String
  cargo       String
  requisitos  String
  salario     String
  beneficios  String
  descricao   String
  localizacao String
  contato     String
  areaEmprego String

  @@map("vagas_empregos")
}

model VagaEstagio {
  idEstagio   Int     @id @default(autoincrement()) @map("id_estagio")
  nomeEmpresa String
  cargo       String
  requisitos  String
  salario     String
  beneficios  String
  descricao   String
  localizacao String
  contato     String
  areaEstagio String

  @@map("vagas_estagio")
}

model Sala {
  idSala   Int           @id @default(autoincrement()) @map("id_sala")
  nomeSala String
  andar    String
  bloco    String
  imagem   String
  horarios HorarioAula[]

  @@map("salas")
}

model HorarioAula {
  idHorariosAula Int     @id @default(autoincrement()) @map("id_horarios_aula")
  nomeCurso      String
  turno          String
  idSala         Int     @map("id_sala")
  sala           Sala   @relation(fields: [idSala], references: [idSala])

  @@map("horarios_aula")
}
